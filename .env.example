# Copy to .env and fill in. Never commit .env.

# Robot
PERSONA_NAME=PersonaAI
PERSONA_WAKE_WORDS=hello
PERSONA_HARDWARE=sim          # sim | <your backend>
PERSONA_TRACKING=0            # 1 to enable the camera face follower

